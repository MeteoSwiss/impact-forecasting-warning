# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Hidden files and directories
.*

# C extensions
*.so

# Distribution / packaging
env/
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
