#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
nosetests.xml
coverage.xml
*.cover
junit*

# mchbuild reports
test_reports/
security_reports/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/

# Sphinx documentation
doc/_build/

# PyBuilder
target/

# celery beat schedule file
celerybeat-schedule

# virtualenv
venv/
ENV/

# mkdocs documentation
/site

# Output results
results/

